# Copy to .env for local dev. Loopback only → DB_TLS=disable is the documented
# exception in dev-plan §16A-G; production uses verify-full + secrets.
DATABASE_URL=postgres://ebook_api:dev-api-pass@127.0.0.1:5432/ebook_dev
WORKER_DATABASE_URL=postgres://ebook_worker:dev-worker-pass@127.0.0.1:5432/ebook_dev
MIGRATOR_DATABASE_URL=postgres://ebook_migrator:dev-migrator-pass@127.0.0.1:5432/ebook_dev
DB_TLS=disable
PORT=3000
# Interface to bind. Default 0.0.0.0 — required inside a container fronted by
# the reverse proxy. On a bare-metal host where the proxy runs alongside the
# API, set 127.0.0.1 so the API is not reachable directly from the network.
# BIND_HOST=0.0.0.0
STORAGE_ROOT=./storage
# Upload bounds (dev-plan §20 starting quotas; conservative defaults)
# IMPORT_MAX_TXT_BYTES=31457280
# IMPORT_MAX_EPUB_BYTES=52428800
# WORKER_POLL_MS=1000

# Origins allowed to make state-changing API calls. Required in dev: the vite
# proxy rewrites Host to the target, so the API can never match host against
# origin and relies on this list.
# For M5 L3 real-device testing add the LAN origin too, or every POST from the
# phone is 403 origin_mismatch:
#   CSRF_ALLOWED_ORIGINS=http://localhost:5173,http://192.168.0.102:5173
CSRF_ALLOWED_ORIGINS=http://localhost:5173

# --- M7 hardening -------------------------------------------------------------
# Read X-Forwarded-For for rate-limit keys. Turn on ONLY when every request
# provably reaches the API through our own reverse proxy — otherwise any client
# can forge the header and bypass the limits below.
# TRUST_PROXY=false
# Send HSTS. Keep off in dev: on a plain-HTTP localhost it would pin the
# browser to https for a year.
# HSTS=false
# Largest JSON body outside the import upload routes.
# MAX_JSON_BYTES=262144
# Auth throttling. Per API process — not distributed, so with N replicas the
# effective limit is N× these numbers (see src/http/rate-limit.ts).
# AUTH_RATE_LIMIT_WINDOW_MS=300000
# AUTH_RATE_LIMIT_MAX_PER_IP=60
# AUTH_RATE_LIMIT_MAX_PER_ACCOUNT=10

# Record the caller's address in request logs. Off by default: IPs are personal
# data and a reading site does not need a per-request location trail to run.
# Turn on for incident response only.
# LOG_CLIENT_IP=false

# Public origin for sitemap.xml, which the protocol requires to hold absolute
# URLs. Scheme + host only. Unset, the sitemap falls back to the request's own
# Host header: convenient in dev, but set it in production so a forged Host
# cannot end up advertised to crawlers.
# SITE_ORIGIN=https://book.example.com
