{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/index.ts",
    "dev:worker": "node --env-file-if-exists=.env --watch src/worker.ts",
    "start": "node --env-file-if-exists=.env src/index.ts",
    "start:worker": "node --env-file-if-exists=.env src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/**/*.test.ts",
    "test:e2e": "node --env-file-if-exists=.env --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate && node --env-file-if-exists=.env scripts/apply-grants.mjs",
    "db:verify": "node --env-file-if-exists=.env scripts/db-verify.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.0",
    "dompurify": "3.4.16",
    "drizzle-orm": "0.45.3",
    "fast-xml-parser": "5.11.1",
    "hono": "4.13.10",
    "jsdom": "30.1.1",
    "jszip": "3.10.2",
    "opencc-js": "1.4.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.3",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "iconv-lite": "^0.7.3",
    "typescript": "7.0.2"
  }
}
