{
  "name": "ebook-reader",
  "private": true,
  "type": "module",
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter server db:migrate",
    "db:verify": "pnpm --filter server db:verify",
    "dev:api": "pnpm --filter server dev",
    "dev:worker": "pnpm --filter server dev:worker",
    "dev:web": "pnpm --filter web dev",
    "dev:lan": "pnpm --filter web dev:lan",
    "seed:l3": "pnpm --filter server seed:l3",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "pnpm -r test",
    "maintenance": "pnpm --filter server maintenance",
    "perf:seed": "pnpm --filter server perf:seed",
    "perf:measure": "pnpm --filter server perf:measure",
    "backup": "pnpm --filter server backup",
    "restore:verify": "pnpm --filter server restore:verify",
    "ops:check": "pnpm --filter server ops:check"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.71.0"
  }
}
